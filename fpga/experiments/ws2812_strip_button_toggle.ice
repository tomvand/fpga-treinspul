              }
            },
            {
              "id": "82034f6e-1386-4029-9fca-83d8712b5e30",
              "type": "basic.constant",
              "data": {
                "name": "CLOCK_DEV",
                "value": "3",
                "local": true
              },
              "position": {
                "x": 432,
                "y": -64
              }
            },
            {
              "id": "92d44bbd-c7be-4386-8826-9cbd706cf0e2",
              "type": "basic.code",
              "data": {
                "ports": {
                  "in": [
                    {
                      "name": "clk"
                    },
                    {
                      "name": "en"
                    }
                  ],
                  "out": [
                    {
                      "name": "clk_out"
                    }
                  ]
                },
                "params": [
                  {
                    "name": "CLOCK_DIVIDER",
                    "range": "[6:0]",
                    "size": 7
                  }
                ],
                "code": "  // CLOCK_DIVIDER // Need around ~2_400_000Hz 3*(1/1.25e-6)\n  reg [5:0] clk_count = 1;\n  reg last_en = 0;\n\n  always @(posedge clk) begin\n    last_en <= en;\n    if (last_en == 0 && en) // rising edge\n      clk_count <=1;\n    else if (en) begin\n      clk_count <= clk_count + 1;\n      if (clk_count >=CLOCK_DIVIDER)\n        clk_count<=0;\n    end\n  end\n  assign clk_out = ~|clk_count;"
              },
              "position": {
                "x": 192,
                "y": 144
              },
              "size": {
                "width": 568,
                "height": 264
              }
            },
            {
              "id": "d057c160-04b6-4cae-9a6d-33223351e655",
              "type": "basic.info",
              "data": {
                "info": "\tDevicer should be 5, but the calculations do not correspont with observations\n\tthe output waveform differs.\n\tto meet timing constrains of the LEDs, we speed up the clock\n\totherwise the leds inperpret all bits as HIGH bits.",
                "readonly": false
              },
              "position": {
                "x": 552,
                "y": 24
              },
              "size": {
                "width": 600,
                "height": 88
              }
            },
            {
              "id": "68ffb0d6-a423-4d78-b060-b7353c0413fa",
              "type": "basic.code",
              "data": {
                "ports": {
                  "in": [
                    {
                      "name": "clk"
                    },
                    {
                      "name": "led_state",
                      "range": "[23:0]",
                      "size": 24
                    },
                    {
                      "name": "start"
                    },
                    {
                      "name": "slow_clk"
                    }
                  ],
                  "out": [
                    {
                      "name": "busy"
                    },
                    {
                      "name": "encoded"
                    },
                    {
                      "name": "start_clock"
                    }
                  ]
                },
                "params": [],
                "code": "\n\nreg _encoded;\nreg _busy;\nreg _start_clock;\n\nassign busy = _busy;\nassign encoded = _encoded;\nassign start_clock = _start_clock;\n\n//ws2812b_clock #(.CLOCK_DIVIDER(CLOCK_DIVIDER)) clock(clk, start_clock, slow_clk);\n\nreg [5:0] current_bit_idx ;\nreg [2:0] state = 3'b111;\n\nwire [23:0] out_buffer;\ngenvar i;\ngenerate\n    for (i=0; i<24; i=i+1) begin: somename\n        assign out_buffer[i] = led_state[23-i];\n    end\nendgenerate\n\nalways @(posedge clk) begin\n  case (state)\n    3'b111: begin\n      if (start) begin\n        _start_clock <= 1;\n        state <= 3'b001;\n        current_bit_idx <=0;\n        _encoded <=1;\n        _busy <=1;\n      end else begin\n        _start_clock <=0;\n        state <= state;\n        current_bit_idx <=current_bit_idx;\n        _encoded <=0;\n        _busy <=0;\n      end\n    end\n    // 3'b000: begin // start\n    //   if (slow_clk) begin\n    //     encoded <= 1'b1; // first third\n    //     state <= 3'b001;\n    //   end\n    // end\n    3'b001: begin\n      if (slow_clk) begin\n        _encoded <= out_buffer[current_bit_idx]; // middle\n        state <= 3'b010;\n      end\n    end\n    3'b010: begin\n      if (slow_clk) begin\n        _encoded <= 1'b0; // end\n        state <= 3'b100;\n        current_bit_idx <= current_bit_idx + 1;\n      end\n    end\n    3'b100: begin\n      if (slow_clk) begin\n        // encoded <= 0; // finalize\n        if (current_bit_idx==24) begin\n          state <= 3'b111;\n          _start_clock <= 0;\n          _busy <=0;\n        end else begin\n          state <= 3'b101;\n          _start_clock <= 0;\n        end\n      end\n    end\n    3'b101: begin\n        _start_clock <= 1;\n        state <= 3'b001;\n        _encoded <=1;\n    end\n  endcase\n\nend"
              },
              "position": {
                "x": 944,
                "y": 696
              },
              "size": {
                "width": 1184,
                "height": 944
              }
            },
            {
              "id": "a77ad217-0002-4965-91c0-20b46b75090d",
              "type": "basic.info",
              "data": {
                "info": "GRB",
                "readonly": false
              },
              "position": {
