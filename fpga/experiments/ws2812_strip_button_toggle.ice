        {
          "id": "d700bc92-c0eb-4bba-b272-2bc5b3e33613",
          "type": "basic.info",
          "data": {
            "info": "DFF\nto uncouple sequential logic\nfrom output serialization",
            "readonly": true
          },
          "position": {
            "x": 912,
            "y": -272
          },
          "size": {
            "width": 272,
            "height": 96
          }
        },
        {
          "id": "b1b05dda-fd12-4ab8-8a88-9112ae2279e7",
          "type": "basic.code",
          "data": {
            "ports": {
              "in": [
                {
                  "name": "clk"
                },
                {
                  "name": "busy"
                }
              ],
              "out": [
                {
                  "name": "_count",
                  "range": "[1:0]",
                  "size": 2
                },
                {
                  "name": "_inc_pulse"
                },
                {
                  "name": "seq_busy"
                }
              ]
            },
            "params": [
              {
                "name": "NUM_LEDS"
              }
            ],
            "code": "reg [4:0] inc_pulse =  0;\nreg signed [4:0] count = -1;\nreg start = 1;\nassign _inc_pulse = inc_pulse;\nassign _count = count;\n\nassign seq_busy = !in_rest;\n\nreg busy_d = 0;                 // delayed busy for edge detect\nreg [11:0] rest_counter = 0;\nreg in_rest = 0;\n\nalways @(posedge clk) begin\n    inc_pulse <= 1'b0;\n    start <= 0; \n\n    // track previous busy\n    busy_d <= busy;\n\n    if (in_rest) begin\n        // rest period active\n        if (rest_counter == 4095) begin\n            rest_counter <= 0;\n            in_rest      <= 0;\n            inc_pulse <= 1;\n        end else begin\n            rest_counter <= rest_counter + 1;\n        end\n    end else begin\n        // detect busy going high -> low\n        if (busy_d && !busy || start) begin\n            if (count >= NUM_LEDS - 1) begin\n                count        <= 0;\n                in_rest      <= 1;\n                rest_counter <= 0;\n            end else begin\n                count     <= count + 1;\n                inc_pulse <= 1;\n            end\n        end\n    end\nend"
          },
          "position": {
            "x": 3216,
            "y": -128
          },
          "size": {
            "width": 488,
            "height": 448
          }
        },
        {
          "id": "c590b28d-f948-45a1-bd01-5e475d4ff3aa",
          "type": "basic.info",
          "data": {
            "info": "Addressable Leds\nare processed sequentially\nHere we mux each led in sequence\nto the led driver",
            "readonly": true
          },
          "position": {
            "x": 1760,
            "y": 0
          },
          "size": {
            "width": 280,
            "height": 120
          }
        },
        {
          "id": "974016b6-a1a2-4625-a622-1f4416b98c5b",
          "type": "basic.info",
          "data": {
            "info": "Led driver",
            "readonly": true
          },
          "position": {
            "x": 3040,
            "y": 136
          },
          "size": {
            "width": 192,
            "height": 128
          }
        },
        {
          "id": "76282ac8-6a91-42c7-aeae-ddbdd78e1a66",
          "type": "basic.info",
          "data": {
            "info": "Clock and sequence generation\nThis will create a slow cloc\nand step through the leds",
            "readonly": true
          },
          "position": {
