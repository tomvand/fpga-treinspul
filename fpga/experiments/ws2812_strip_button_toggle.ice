                "y": -96
              }
            },
            {
              "id": "2b116f4a-1eb0-4542-b65d-b383511a5085",
              "type": "basic.code",
              "data": {
                "ports": {
                  "in": [
                    {
                      "name": "clk"
                    },
                    {
                      "name": "sin",
                      "range": "[1:0]",
                      "size": 2
                    },
                    {
                      "name": "din",
                      "range": "[63:0]",
                      "size": 64
                    },
                    {
                      "name": "load"
                    },
                    {
                      "name": "shift"
                    }
                  ],
                  "out": [
                    {
                      "name": "sout",
                      "range": "[1:0]",
                      "size": 2
                    },
                    {
                      "name": "q",
                      "range": "[63:0]",
                      "size": 64
                    }
                  ]
                },
                "params": [
                  {
                    "name": "INI"
                  }
                ],
                "code": "//-- Generic Shift Right register\n//-- With reset input\n//-- Number of bits\nlocalparam N = 64;\n\n//-- Initial value\nreg [N-1:0] qi = INI;\n\nalways @(posedge clk)\nbegin\n\n  //-- Load\n  if (load == 1)\n    qi <= din[63:0];\n    \n  else\n    //-- Shift to the right when the\n    //-- shift iput is 1\n    if (shift == 1)\n\n      //-- Shift to the right\n      qi <= {sin[1:0],qi[N-1:2]};\nend\n\n//-- Serial out: \n//-- It is the least significant bit\nassign sout = qi[1:0];\n\n//-- Paralell out\nassign q = qi;"
              },
              "position": {
                "x": 376,
                "y": 24
              },
              "size": {
                "width": 368,
                "height": 456
              }
            }
          ],
          "wires": [
