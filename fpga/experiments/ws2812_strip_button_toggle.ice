              }
            },
            {
              "id": "8efecf93-37df-49d6-8a64-0b3e988a2b7c",
              "type": "basic.input",
              "data": {
                "name": "ce",
                "clock": false
              },
              "position": {
                "x": -136,
                "y": 56
              }
            },
            {
              "id": "f25e9a9e-cd4c-4025-8745-0691a99a3fb8",
              "type": "basic.input",
              "data": {
                "name": "",
                "clock": false
              },
              "position": {
                "x": -136,
                "y": 128
              }
            },
            {
              "id": "cf6fe46f-cd0d-4a77-be7a-dd6aa92801fa",
              "type": "basic.code",
              "data": {
                "ports": {
                  "in": [
                    {
                      "name": "clk"
                    },
                    {
                      "name": "ce"
                    },
                    {
                      "name": "d"
                    }
                  ],
                  "out": [
                    {
                      "name": "q"
                    }
                  ]
                },
                "params": [],
                "code": "//-- Two D flip-flops\n//-- connected in cascade\n\nreg q1 = 0;\nreg q2 = 0;\n\nalways @(posedge clk) \nbegin\n  if (ce) begin\n      //-- First D Flip-Flop\n      q1 <= d;\n      \n      //-- Secondo D Flip-flop\n      q2 <= q1;\n  end\nend\n\n//-- Assign the output\nassign q = q2;"
              },
              "position": {
                "x": 32,
                "y": -56
              },
              "size": {
